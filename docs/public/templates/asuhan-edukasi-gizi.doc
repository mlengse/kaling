    <div class="kop-surat">
        <p class="kop-title">KLINIK PRATAMA / UTAMA KELUARGA SEHAT</p>
        <p class="kop-subtitle">Jl. Raya Pembangunan No. 123, Jakarta Selatan | Telp: (021) 555-1234 | Email: info@keluargasehat.com</p>
